# Copiar a .env.local para desarrollo. En producción se configuran en Vercel.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=clave-publica-anon
# Solo servidor. Nunca exponer en el navegador. Se usa para invitar residentes.
SUPABASE_SERVICE_ROLE_KEY=clave-secreta-service-role
# URL pública de la app (para los enlaces de invitación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
